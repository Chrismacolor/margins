#!/bin/sh
#
# margins — command-line launcher for Margins.app.
#
# Ships inside the app bundle at Contents/Resources/margins-cli; the Homebrew
# cask symlinks it into PATH as `margins`. Never edit this file inside an
# installed bundle — the bundle is code-signed and any change breaks the seal.
#
#   margins <file.md> ...     open Markdown file(s) in Margins
#   margins <dir> | margins . open the newest Markdown file under a directory
#   margins -w [dir] ...      watch a folder (keep showing its newest Markdown)
#   some-cmd | margins [-]    render piped Markdown, streaming as it arrives
#   margins -g ...            open in the background (no focus steal)
#   margins --help|--version
#
# MARGINS_DRY_RUN=1 prints what would be opened instead of opening (tests).

set -eu

BUNDLE_ID="com.disanto.margins"
OPEN_FLAGS=""
WATCH=0

usage() {
  cat <<'EOF'
usage: margins <file.md> ...     open Markdown file(s) in Margins
       margins <dir>             open the newest Markdown file under <dir>
                                 (so `margins .` shows what an agent just wrote)
       margins -w [dir]          watch a folder: Margins keeps showing its
                                 newest Markdown file, switching as your agent
                                 writes (default: the current directory)
       some-cmd | margins [-]    render piped Markdown (streams live as the
                                 pipe fills; turn on the Follow pill to keep
                                 the newest output in view)
       margins -g ...            background open — render without stealing
                                 focus (for hooks and scripts)
       margins --help            show this help
       margins --version         print the app version

Margins shows one document per window request; with multiple files only the
first is displayed.
EOF
}

version() {
  self="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"
  plist="$(dirname "$self")/../Info.plist"
  if v="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$plist" 2>/dev/null)"; then
    printf '%s\n' "$v"
  else
    printf 'unknown\n'
  fi
}

# Bundle id first (works even if the app was renamed); `-a` fallback covers
# dev builds that LaunchServices hasn't registered yet. $OPEN_FLAGS is
# intentionally unquoted: it is either empty or a flag list for open(1).
open_app() {
  if [ "${MARGINS_DRY_RUN:-0}" = "1" ]; then
    for f in "$@"; do printf 'DRY%s %s\n' "${OPEN_FLAGS:+ $OPEN_FLAGS}" "$f"; done
    return 0
  fi
  open $OPEN_FLAGS -b "$BUNDLE_ID" "$@" 2>/dev/null || open $OPEN_FLAGS -a "Margins" "$@"
}

# Newest Markdown file under a directory, skipping hidden dirs and
# node_modules. stat/sort/cut tolerates spaces in paths (not newlines).
newest_md() {
  find "$1" -type f \( -name '*.md' -o -name '*.markdown' -o -name '*.mdown' \) \
    -not -path '*/.*' -not -path '*/node_modules/*' \
    -exec stat -f '%m %N' {} + 2>/dev/null | sort -rn | head -n 1 | cut -d' ' -f2-
}

while [ $# -gt 0 ]; do
  case "$1" in
    -g|--background) OPEN_FLAGS="-g"; shift ;;
    -w|--watch) WATCH=1; shift ;;
    -h|--help) usage; exit 0 ;;
    --version) version; exit 0 ;;
    *) break ;;
  esac
done

# Watch mode: pass directories straight through — the app resolves (and keeps
# resolving) the newest Markdown file itself. An empty folder is fine: the
# viewer waits for the first Markdown file to appear.
if [ "$WATCH" = "1" ]; then
  [ $# -gt 0 ] || set -- .
  for d in "$@"; do
    if [ ! -d "$d" ]; then
      printf 'margins: --watch expects a directory, got %s\n' "$d" >&2
      exit 64
    fi
  done
  open_app "$@"
  exit 0
fi

if [ "${1:-}" = "-" ] || { [ $# -eq 0 ] && [ ! -t 0 ]; }; then
  # Spool stdin into a watched temp file. Open it first (empty), then append:
  # each write fires the app's file watcher, so content renders as it arrives.
  # macOS mktemp has no --suffix; a fixed name inside a temp dir gives the
  # .md extension and a clean window title. The file is left for the system's
  # periodic TMPDIR purge — the app may still be reading it after we exit.
  dir="$(mktemp -d "${TMPDIR:-/tmp}/margins.XXXXXX")"
  file="$dir/stdin.md"
  : > "$file"
  open_app "$file"
  cat >> "$file"
  exit 0
fi

if [ $# -eq 0 ]; then
  usage >&2
  exit 64
fi

# Resolve directory arguments to the newest Markdown file beneath them.
for a in "$@"; do
  shift
  if [ -d "$a" ]; then
    m="$(newest_md "$a")"
    if [ -z "$m" ]; then
      printf 'margins: no Markdown files under %s\n' "$a" >&2
      exit 66
    fi
    a="$m"
  fi
  set -- "$@" "$a"
done

open_app "$@"
